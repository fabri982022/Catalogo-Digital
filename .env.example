# MySQL
MYSQL_DATABASE=catalogo_digital
MYSQL_ROOT_PASSWORD=change-this-password
MYSQL_USER=catalogo
MYSQL_PASSWORD=change-this-password
MYSQL_PORT=3307

# Backend
BACKEND_PORT=8080
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/catalogo_digital?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-this-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend and Adminer
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api
ADMINER_PORT=8081

# Nextcloud documental
NEXTCLOUD_PORT=8082
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change-this-password
NEXTCLOUD_DB_ROOT_PASSWORD=change-this-password
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-this-password
NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud

# Backup automatico cada 6 horas mediante WebDAV
BACKUP_INTERVAL_SECONDS=21600
NEXTCLOUD_WEBDAV_URL=http://nextcloud/remote.php/dav/files
NEXTCLOUD_BACKUP_USER=backup
NEXTCLOUD_BACKUP_APP_PASSWORD=change-this-app-password
NEXTCLOUD_BACKUP_PATH=Backups/Base-de-datos

# Integrantes mostrados en el footer
VITE_TEAM_MEMBERS=Nombre 1, Nombre 2
