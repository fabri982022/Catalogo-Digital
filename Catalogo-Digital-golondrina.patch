+      ejecutar: () => {
+        const lineas = categorias.map((c) => `• ${c.nombre}: ${productos.filter((p) => p.categoriaId === c.id).length}`)
+        return `Hay ${piezas(productos.length)} en total.\n${lineas.join('\n')}`
+      },
